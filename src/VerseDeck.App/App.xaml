<Application x:Class="VerseDeck.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VerseDeck.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the active theme; ThemeService swaps it at runtime. -->
                <ResourceDictionary Source="Themes/Neutral.xaml"/>
                <ResourceDictionary Source="Themes/Icons.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <local:IconKeyToGeometryConverter x:Key="IconKeyToGeometry"/>
            <local:SectionEqualsConverter x:Key="SectionEquals"/>
            <local:UpperCaseConverter x:Key="Upper"/>
            <local:BytesToImageConverter x:Key="BytesToImage"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
