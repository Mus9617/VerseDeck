<UserControl x:Class="VerseDeck.App.Views.AboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="A BORDO" Style="{StaticResource H1}"/>
            <TextBlock Text="Checklists guiadas, temporizadores con aviso y bitacora. Cada 'hecho' envia como mucho la pulsacion de su paso; nunca se encadenan." Style="{StaticResource Muted}"/>

            <!-- Checklists -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="CHECKLIST EN MARCHA" Style="{StaticResource SectionHeader}" Margin="0"/>
                    <TextBlock Text="{Binding Aboard.RunnerStatus}" Style="{StaticResource H2}" Margin="0,6,0,10" TextWrapping="Wrap"/>
                    <WrapPanel Visibility="{Binding Aboard.IsRunning, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="HECHO" Style="{StaticResource PrimaryButton}" Command="{Binding Aboard.DoneCommand}"/>
                        <Button Content="SALTAR" Command="{Binding Aboard.SkipCommand}"/>
                        <Button Content="REPETIR" Command="{Binding Aboard.RepeatCommand}"/>
                        <Button Content="CANCELAR" Style="{StaticResource DangerButton}" Command="{Binding Aboard.CancelRunCommand}"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="Por voz: 'checklist prevuelo' o 'empezar prevuelo', luego 'hecho', 'siguiente' o 'listo'. Tambien 'saltar', 'repetir' y 'cancelar checklist'."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="CHECKLISTS DEL PERFIL" Style="{StaticResource SectionHeader}" Margin="0"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ListBox ItemsSource="{Binding Aboard.Checklists}" SelectedItem="{Binding Aboard.SelectedChecklist}" DisplayMemberPath="Name" MinHeight="120"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="EMPEZAR" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding Aboard.StartCommand}" CommandParameter="{Binding Aboard.SelectedChecklist}"/>
                                <Button Content="NUEVA" Command="{Binding Aboard.NewChecklistCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="NOMBRE (ES LO QUE DICES DESPUES DE 'CHECKLIST')" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Aboard.EditName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="PASOS" Style="{StaticResource FieldLabel}"/>
                            <ItemsControl ItemsSource="{Binding Aboard.EditSteps}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                                            <ComboBox Grid.Column="2" DisplayMemberPath="Name" SelectedItem="{Binding Module}"
                                                      ItemsSource="{Binding DataContext.Aboard.ModuleChoices, ElementName=Root}"/>
                                            <Button Grid.Column="3" Content="SUBIR" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.Aboard.MoveUpCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                            <Button Grid.Column="4" Content="QUITAR"
                                                    Command="{Binding DataContext.Aboard.RemoveStepCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="ANADIR PASO" Command="{Binding Aboard.AddStepCommand}"/>
                                <Button Content="GUARDAR" Style="{StaticResource PrimaryButton}" Command="{Binding Aboard.SaveChecklistCommand}"/>
                                <Button Content="ELIMINAR" Style="{StaticResource DangerButton}" Command="{Binding Aboard.DeleteChecklistCommand}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Un paso con modulo envia su tecla al decir 'hecho'. Sin modulo, solo avanza: para lo que haces tu (pedir permiso, mirar el radar)."/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Timers -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="TEMPORIZADORES" Style="{StaticResource SectionHeader}" Margin="0"/>
                    <WrapPanel Margin="0,8,0,0">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="ETIQUETA" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Aboard.TimerLabels}" Text="{Binding Aboard.NewTimerLabel}" IsEditable="True" Width="170"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="MINUTOS" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding Aboard.NewTimerMinutes, UpdateSourceTrigger=PropertyChanged}" Width="70" FontFamily="{DynamicResource MonoFont}"/>
                        </StackPanel>
                        <Button Content="INICIAR" Style="{StaticResource PrimaryButton}" Command="{Binding Aboard.AddTimerCommand}" VerticalAlignment="Bottom"/>
                        <Button Content="CANCELAR TODOS" Command="{Binding Aboard.CancelAllTimersCommand}" VerticalAlignment="Bottom"/>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding Aboard.Timers}" Focusable="False" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Left" Grid.Column="1" Text="{Binding RemainingText}" FontFamily="{DynamicResource MonoFont}" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" HorizontalAlignment="Left" Content="QUITAR"
                                                Command="{Binding DataContext.Aboard.CancelTimerCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Fired}" Value="True">
                                        <Setter TargetName="Left" Property="Foreground" Value="{DynamicResource Warning}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="Por voz: 'avisame en diez minutos' o con etiqueta delante, 'refineria treinta minutos'. 'Cancelar temporizadores' los quita todos. El copiloto avisa en voz alta; si esta apagado, suena el pitido de comando."/>
                </StackPanel>
            </Border>

            <!-- Logbook -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="BITACORA" Style="{StaticResource SectionHeader}" Margin="0"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Aboard.NewNote, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding Aboard.AddNoteCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="ANOTAR" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding Aboard.AddNoteCommand}"/>
                        <Button Grid.Column="2" Content="EXPORTAR" Command="{Binding Aboard.ExportCommand}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Aboard.Notes}" Focusable="False" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd/MM HH:mm}}" FontFamily="{DynamicResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ShipName}" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Text}" Style="{StaticResource Body}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Button Grid.Column="3" Content="BORRAR"
                                                Command="{Binding DataContext.Aboard.DeleteNoteCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="Por voz: 'anota' seguido de lo que quieras recordar. El dictado de Windows no es perfecto con nombres propios; revisa la nota aqui. Exportar guarda un .txt en Documentos."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
