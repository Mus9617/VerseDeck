<UserControl x:Class="VerseDeck.App.Views.ActivityPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Padding="14,8">
        <StackPanel>
            <ToggleButton x:Name="Toggle" Cursor="Hand" Focusable="True" FocusVisualStyle="{x:Null}">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <DockPanel Background="Transparent">
                            <Path x:Name="Chevron" DockPanel.Dock="Right" Data="M0 6 L5 1 L10 6" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.5"
                                  Width="10" Height="7" VerticalAlignment="Center"/>
                            <TextBlock Text="ACTIVIDAD" Style="{StaticResource SectionHeader}" Margin="0"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="Data" Value="M0 1 L5 6 L10 1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <ListBox ItemsSource="{Binding Activity.Entries}" Height="132" Margin="0,8,0,4"
                     Visibility="{Binding IsChecked, ElementName=Toggle, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>
    </Border>
</UserControl>
