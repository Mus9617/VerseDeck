<Window x:Class="VerseDeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VerseDeck.App.Views"
        xmlns:vm="clr-namespace:VerseDeck.App.ViewModels"
        Title="VerseDeck Companion" Height="900" Width="1440" MinHeight="760" MinWidth="1180"
        Icon="pack://siteoforigin:,,,/icon.png"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        FontFamily="{DynamicResource BodyFont}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- Header chip: Tag is the label, Content is a LinkState. -->
        <Style x:Key="LinkChip" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Style="{StaticResource StatusChip}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot" Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource TextMuted}"/>
                                <TextBlock Text="{TemplateBinding Tag}" Margin="8,0,6,0" FontFamily="{DynamicResource HeadingFont}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="StateText" Text="OFFLINE" FontFamily="{DynamicResource HeadingFont}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Content" Value="{x:Static vm:LinkState.Armed}">
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Warning}"/>
                                <Setter TargetName="StateText" Property="Text" Value="PTT"/>
                            </Trigger>
                            <Trigger Property="Content" Value="{x:Static vm:LinkState.Online}">
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Positive}"/>
                                <Setter TargetName="StateText" Property="Text" Value="ONLINE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="VERSEDECK" Style="{StaticResource H1}"/>
                    <TextBlock Text="COMPANION" Style="{StaticResource H1}" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,2,0,0">
                    <TextBlock Text="{Binding ProfileTitle}" Style="{StaticResource H2}" Foreground="{DynamicResource Accent}"/>
                    <TextBlock Text="/" Style="{StaticResource H2}" Foreground="{DynamicResource TextMuted}" Margin="10,0"/>
                    <TextBlock Text="{Binding ShipTitle}" Style="{StaticResource H2}" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Width="190" ItemsSource="{Binding Profile.Profiles}" SelectedItem="{Binding Profile.SelectedProfile}" DisplayMemberPath="Name"
                              ToolTip="Perfil guardado"/>
                    <Button Content="CARGAR" Command="{Binding Profile.LoadCommand}" Margin="8,0,8,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource LinkChip}" Tag="VOZ" Content="{Binding Voice.State}"/>
                    <ContentControl Style="{StaticResource LinkChip}" Tag="LAN" Content="{Binding Mobile.State}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Rail + section -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,12,0,0">
                    <RadioButton Style="{StaticResource NavButton}" Content="DECK" Tag="{StaticResource Icon.nav.deck}"
                                 IsChecked="{Binding Section, Converter={StaticResource SectionEquals}, ConverterParameter=Deck}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="CONTROLES" Tag="{StaticResource Icon.nav.controls}"
                                 IsChecked="{Binding Section, Converter={StaticResource SectionEquals}, ConverterParameter=Controles}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="VOZ" Tag="{StaticResource Icon.nav.voice}"
                                 IsChecked="{Binding Section, Converter={StaticResource SectionEquals}, ConverterParameter=Voz}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="MOVIL" Tag="{StaticResource Icon.nav.mobile}"
                                 IsChecked="{Binding Section, Converter={StaticResource SectionEquals}, ConverterParameter=Movil}"/>
                    <RadioButton Style="{StaticResource NavButton}" Content="AJUSTES" Tag="{StaticResource Icon.nav.settings}"
                                 IsChecked="{Binding Section, Converter={StaticResource SectionEquals}, ConverterParameter=Ajustes}"/>
                </StackPanel>
            </Border>
            <Grid Grid.Column="1">
                <views:DeckView Visibility="{Binding Section, Converter={StaticResource SectionEquals}, ConverterParameter=Deck}"/>
                <views:ControlsView Visibility="{Binding Section, Converter={StaticResource SectionEquals}, ConverterParameter=Controles}"/>
                <views:VoiceView Visibility="{Binding Section, Converter={StaticResource SectionEquals}, ConverterParameter=Voz}"/>
                <views:MobileView Visibility="{Binding Section, Converter={StaticResource SectionEquals}, ConverterParameter=Movil}"/>
                <views:SettingsView Visibility="{Binding Section, Converter={StaticResource SectionEquals}, ConverterParameter=Ajustes}"/>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <DockPanel Margin="20,0,16,0">
                <TextBlock DockPanel.Dock="Right" Text="Creada con mucho amor por Zowix" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,24,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</Window>
