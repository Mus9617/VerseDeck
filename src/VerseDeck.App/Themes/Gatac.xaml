<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Xi'an: violeta y lila sobre negro, como la cabina de la Syulen -->
    <SolidColorBrush x:Key="Bg" Color="#0B0A14"/>
    <SolidColorBrush x:Key="Surface" Color="#141228"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="#1D1A36"/>
    <SolidColorBrush x:Key="Line" Color="#3A3366"/>
    <SolidColorBrush x:Key="Text" Color="#ECE8FF"/>
    <SolidColorBrush x:Key="TextMuted" Color="#A59CD0"/>
    <SolidColorBrush x:Key="Accent" Color="#B48CFF"/>
    <SolidColorBrush x:Key="OnAccent" Color="#0B0A14"/>
    <SolidColorBrush x:Key="Positive" Color="#5BE3C4"/>
    <SolidColorBrush x:Key="Danger" Color="#FF6B93"/>
    <SolidColorBrush x:Key="Warning" Color="#FFC46B"/>
    <SolidColorBrush x:Key="Glow" Color="#C77DFF"/>
    <CornerRadius x:Key="Radius">8</CornerRadius>
    <Thickness x:Key="Stroke">1</Thickness>
    <FontFamily x:Key="HeadingFont">/VerseDeck.App;component/Fonts/#Barlow Condensed</FontFamily>
    <FontFamily x:Key="BodyFont">/VerseDeck.App;component/Fonts/#Barlow</FontFamily>
    <FontFamily x:Key="MonoFont">/VerseDeck.App;component/Fonts/#JetBrains Mono</FontFamily>
</ResourceDictionary>