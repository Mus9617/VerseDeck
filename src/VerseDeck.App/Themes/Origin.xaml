<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg" Color="#F3F1EC"/>
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="#F8F7F3"/>
    <SolidColorBrush x:Key="Line" Color="#D9D5CC"/>
    <SolidColorBrush x:Key="Text" Color="#15171A"/>
    <SolidColorBrush x:Key="TextMuted" Color="#5E6269"/>
    <SolidColorBrush x:Key="Accent" Color="#15171A"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Positive" Color="#2E7D4F"/>
    <SolidColorBrush x:Key="Danger" Color="#B3261E"/>
    <SolidColorBrush x:Key="Warning" Color="#9A6700"/>
    <CornerRadius x:Key="Radius">10</CornerRadius>
    <Thickness x:Key="Stroke">1</Thickness>
    <FontFamily x:Key="HeadingFont">/VerseDeck.App;component/Fonts/#Barlow Condensed</FontFamily>
    <FontFamily x:Key="BodyFont">/VerseDeck.App;component/Fonts/#Barlow</FontFamily>
    <FontFamily x:Key="MonoFont">/VerseDeck.App;component/Fonts/#JetBrains Mono</FontFamily>
</ResourceDictionary>
