<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg" Color="#0D1014"/>
    <SolidColorBrush x:Key="Surface" Color="#171C22"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="#202731"/>
    <SolidColorBrush x:Key="Line" Color="#33404F"/>
    <SolidColorBrush x:Key="Text" Color="#E3E9F0"/>
    <SolidColorBrush x:Key="TextMuted" Color="#8795A6"/>
    <SolidColorBrush x:Key="Accent" Color="#4F8FE0"/>
    <SolidColorBrush x:Key="OnAccent" Color="#0D1014"/>
    <SolidColorBrush x:Key="Positive" Color="#57B894"/>
    <SolidColorBrush x:Key="Danger" Color="#E0564F"/>
    <SolidColorBrush x:Key="Warning" Color="#E0A84F"/>
    <SolidColorBrush x:Key="Glow" Color="#4F8FE0"/>
    <CornerRadius x:Key="Radius">2</CornerRadius>
    <Thickness x:Key="Stroke">1</Thickness>
    <FontFamily x:Key="HeadingFont">/VerseDeck.App;component/Fonts/#Barlow Condensed</FontFamily>
    <FontFamily x:Key="BodyFont">/VerseDeck.App;component/Fonts/#Barlow</FontFamily>
    <FontFamily x:Key="MonoFont">/VerseDeck.App;component/Fonts/#JetBrains Mono</FontFamily>
</ResourceDictionary>
