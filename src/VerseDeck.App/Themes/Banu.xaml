<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Banu: oro y bronce de mercader -->
    <SolidColorBrush x:Key="Bg" Color="#12100A"/>
    <SolidColorBrush x:Key="Surface" Color="#1C1810"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="#262016"/>
    <SolidColorBrush x:Key="Line" Color="#4A3F28"/>
    <SolidColorBrush x:Key="Text" Color="#F7EEDB"/>
    <SolidColorBrush x:Key="TextMuted" Color="#BFAE88"/>
    <SolidColorBrush x:Key="Accent" Color="#E8B04A"/>
    <SolidColorBrush x:Key="OnAccent" Color="#12100A"/>
    <SolidColorBrush x:Key="Positive" Color="#8ACF6B"/>
    <SolidColorBrush x:Key="Danger" Color="#F27A66"/>
    <SolidColorBrush x:Key="Warning" Color="#F5C86B"/>
    <SolidColorBrush x:Key="Glow" Color="#FFC75A"/>
    <CornerRadius x:Key="Radius">10</CornerRadius>
    <Thickness x:Key="Stroke">1</Thickness>
    <FontFamily x:Key="HeadingFont">/VerseDeck.App;component/Fonts/#Barlow Condensed</FontFamily>
    <FontFamily x:Key="BodyFont">/VerseDeck.App;component/Fonts/#Barlow</FontFamily>
    <FontFamily x:Key="MonoFont">/VerseDeck.App;component/Fonts/#JetBrains Mono</FontFamily>
</ResourceDictionary>