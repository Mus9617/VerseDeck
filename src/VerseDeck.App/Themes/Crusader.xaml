<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Crusader: cielo nocturno y celeste -->
    <SolidColorBrush x:Key="Bg" Color="#0B0F1A"/>
    <SolidColorBrush x:Key="Surface" Color="#121828"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="#1A2236"/>
    <SolidColorBrush x:Key="Line" Color="#2E3A57"/>
    <SolidColorBrush x:Key="Text" Color="#EAF0FF"/>
    <SolidColorBrush x:Key="TextMuted" Color="#98A6C6"/>
    <SolidColorBrush x:Key="Accent" Color="#6FB7FF"/>
    <SolidColorBrush x:Key="OnAccent" Color="#08101E"/>
    <SolidColorBrush x:Key="Positive" Color="#59C9A5"/>
    <SolidColorBrush x:Key="Danger" Color="#F26B75"/>
    <SolidColorBrush x:Key="Warning" Color="#F5C26B"/>
    <SolidColorBrush x:Key="Glow" Color="#9FD0FF"/>
    <CornerRadius x:Key="Radius">6</CornerRadius>
    <Thickness x:Key="Stroke">1</Thickness>
    <FontFamily x:Key="HeadingFont">/VerseDeck.App;component/Fonts/#Barlow Condensed</FontFamily>
    <FontFamily x:Key="BodyFont">/VerseDeck.App;component/Fonts/#Barlow</FontFamily>
    <FontFamily x:Key="MonoFont">/VerseDeck.App;component/Fonts/#JetBrains Mono</FontFamily>
</ResourceDictionary>