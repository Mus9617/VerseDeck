<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg" Color="#0E1317"/>
    <SolidColorBrush x:Key="Surface" Color="#161D23"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="#1E2730"/>
    <SolidColorBrush x:Key="Line" Color="#2C3944"/>
    <SolidColorBrush x:Key="Text" Color="#E6EDF2"/>
    <SolidColorBrush x:Key="TextMuted" Color="#8A9BA8"/>
    <SolidColorBrush x:Key="Accent" Color="#5FB8C9"/>
    <SolidColorBrush x:Key="OnAccent" Color="#0E1317"/>
    <SolidColorBrush x:Key="Positive" Color="#5DBB8A"/>
    <SolidColorBrush x:Key="Danger" Color="#E0564F"/>
    <SolidColorBrush x:Key="Warning" Color="#E0A84F"/>
    <SolidColorBrush x:Key="Glow" Color="#5FB8C9"/>
    <CornerRadius x:Key="Radius">4</CornerRadius>
    <Thickness x:Key="Stroke">1</Thickness>
    <FontFamily x:Key="HeadingFont">/VerseDeck.App;component/Fonts/#Barlow Condensed</FontFamily>
    <FontFamily x:Key="BodyFont">/VerseDeck.App;component/Fonts/#Barlow</FontFamily>
    <FontFamily x:Key="MonoFont">/VerseDeck.App;component/Fonts/#JetBrains Mono</FontFamily>
</ResourceDictionary>
