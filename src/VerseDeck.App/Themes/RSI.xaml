<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Roberts Space Industries: azul limpio -->
    <SolidColorBrush x:Key="Bg" Color="#0A1018"/>
    <SolidColorBrush x:Key="Surface" Color="#111A26"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="#182333"/>
    <SolidColorBrush x:Key="Line" Color="#2B3B52"/>
    <SolidColorBrush x:Key="Text" Color="#E6EEF7"/>
    <SolidColorBrush x:Key="TextMuted" Color="#93A7BF"/>
    <SolidColorBrush x:Key="Accent" Color="#3FA9F5"/>
    <SolidColorBrush x:Key="OnAccent" Color="#06121E"/>
    <SolidColorBrush x:Key="Positive" Color="#4FC08D"/>
    <SolidColorBrush x:Key="Danger" Color="#F06A6A"/>
    <SolidColorBrush x:Key="Warning" Color="#F2B84B"/>
    <SolidColorBrush x:Key="Glow" Color="#3FA9F5"/>
    <CornerRadius x:Key="Radius">3</CornerRadius>
    <Thickness x:Key="Stroke">1</Thickness>
    <FontFamily x:Key="HeadingFont">/VerseDeck.App;component/Fonts/#Barlow Condensed</FontFamily>
    <FontFamily x:Key="BodyFont">/VerseDeck.App;component/Fonts/#Barlow</FontFamily>
    <FontFamily x:Key="MonoFont">/VerseDeck.App;component/Fonts/#JetBrains Mono</FontFamily>
</ResourceDictionary>