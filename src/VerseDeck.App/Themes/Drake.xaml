<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Bg" Color="#121110"/>
    <SolidColorBrush x:Key="Surface" Color="#1C1A17"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="#26231F"/>
    <SolidColorBrush x:Key="Line" Color="#3A342C"/>
    <SolidColorBrush x:Key="Text" Color="#EDE6DA"/>
    <SolidColorBrush x:Key="TextMuted" Color="#9A8F7E"/>
    <SolidColorBrush x:Key="Accent" Color="#E0A030"/>
    <SolidColorBrush x:Key="OnAccent" Color="#121110"/>
    <SolidColorBrush x:Key="Positive" Color="#8DB04A"/>
    <SolidColorBrush x:Key="Danger" Color="#E0452F"/>
    <SolidColorBrush x:Key="Warning" Color="#E0A030"/>
    <SolidColorBrush x:Key="Glow" Color="#E0A030"/>
    <CornerRadius x:Key="Radius">0</CornerRadius>
    <Thickness x:Key="Stroke">2</Thickness>
    <FontFamily x:Key="HeadingFont">/VerseDeck.App;component/Fonts/#Barlow Condensed</FontFamily>
    <FontFamily x:Key="BodyFont">/VerseDeck.App;component/Fonts/#Barlow</FontFamily>
    <FontFamily x:Key="MonoFont">/VerseDeck.App;component/Fonts/#JetBrains Mono</FontFamily>
</ResourceDictionary>
